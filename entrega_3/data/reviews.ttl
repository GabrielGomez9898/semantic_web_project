    rbo:mbid "93ba2e63-8551-44ac-9235-2debf36df8d4" ;
    rbo:publishedOn "2018-11-08T19:40:44+00:00"^^xsd:dateTime ;
    rbo:rating 4 ;
    rbo:reviewText "A four and a half is about right for this album. I could not give it that because it switches between four and five. This album shwed a style of music that I enjoyed. Taking things from the second album and improving in this one."@en ;
    rbo:reviewUrl "https://critiquebrainz.org/review/93ba2e63-8551-44ac-9235-2debf36df8d4"^^xsd:anyURI ;
    rbo:reviewsAlbum res:Album_d8994512-160a-32c1-af0d-d5932f0f59df ;
