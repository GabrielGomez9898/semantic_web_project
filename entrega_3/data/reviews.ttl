    rbo:publishedOn "2023-11-07T15:10:35+00:00"^^xsd:dateTime ;
    rbo:rating 5 ;
    rbo:reviewText "My favorite album. Every song is great, and I really, really enjoy the psychedelic vibes. It's hard to pick a favorite track. Literally, blows out of the water all other albums I've listened to thus far."@en ;
    rbo:reviewUrl "https://critiquebrainz.org/review/c1303fa4-9fa4-45b2-a911-0390f3f30e3c"^^xsd:anyURI ;
