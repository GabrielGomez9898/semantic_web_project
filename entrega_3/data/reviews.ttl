    rbo:mbid "150a662d-a209-409f-8c10-afa4d0412a73" ;
    rbo:publishedOn "2024-05-02T20:33:45+00:00"^^xsd:dateTime ;
    rbo:rating 3 ;
    rbo:reviewText "*Use Your Mind* nous laisse sur une impression plutôt bonne, mais il est vrai que le poids de *Deaf Dumb Blind* se fait fortement ressentir, et que ce 2nd opus supporte mal la comparaison. S'il est bien entendu indispensable pour les amateurs, rien que pour un « Pin Me Down », un « Die High » ou un « Pay the Bill » des familles, il s'avère quand même bien moins inspiré que la première salve."@fr ;
    rbo:reviewUrl "https://critiquebrainz.org/review/150a662d-a209-409f-8c10-afa4d0412a73"^^xsd:anyURI ;
    rbo:reviewsAlbum res:Album_714e6f12-57e8-3c13-8715-a6ac82c885a9 ;
    rbo:writtenBy res:User_3b975ded-aee7-4c4e-9a71-51b960f299ba .

