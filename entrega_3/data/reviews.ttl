    rbo:publishedOn "2025-01-02T20:31:18+00:00"^^xsd:dateTime ;
    rbo:rating 5 ;
    rbo:reviewText "This is yet another fantastic song from the album “All in the Name of Love“. Of course, Barbara Weathers, one of my favorite members of Atlantic Starr, performs this song. This **VERY** *easily* made *One Lover at a Time* one of my all-time favorite songs"@en ;
    rbo:reviewUrl "https://critiquebrainz.org/review/d0ad18c9-24aa-4861-92f3-a98377dc2e42"^^xsd:anyURI ;
