    rbo:rating 4 ;
    rbo:reviewText """**Umläut**, ou la suite logique de la discographie de **Mr Bungle**, avec en prime un net penchant pour l'univers de la B.O. de film fantastico-merveilleux… Plus un tube incroyable: « Atlas Face », avec Mike Patton en personne.\r
\r
Pour en savoir plus : https://www.coreandco.fr/chroniques/umlaut-umlaut-3522.html"""@fr ;
    rbo:reviewUrl "https://critiquebrainz.org/review/8d06777e-1f19-4bde-a8c4-93c8e8daf686"^^xsd:anyURI ;
    rbo:reviewsAlbum res:Album_bba19d51-5b57-4193-8d76-e8294a8dd72a ;
