    rbo:reviewUrl "https://critiquebrainz.org/review/e005876b-590a-4218-9ee9-cb29b3658954"^^xsd:anyURI ;
    rbo:reviewsAlbum res:Album_b534aa01-d621-31ba-9278-38a500e3cdca ;
