    rbo:publishedOn "2023-03-03T13:38:25+00:00"^^xsd:dateTime ;
    rbo:rating 5 ;
    rbo:reviewUrl "https://critiquebrainz.org/review/43fc2173-d0dd-4301-a6a3-9edd10bf80ff"^^xsd:anyURI ;
    rbo:reviewsAlbum res:Album_0dd5a352-6ae0-3e0d-bf18-bec30e27807d ;
