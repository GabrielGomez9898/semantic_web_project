    rbo:publishedOn "2026-10-04T03:36:56+00:00"^^xsd:dateTime ;
    rbo:rating 4 ;
    rbo:reviewUrl "https://critiquebrainz.org/review/2ce127ff-aba1-4946-987f-e44415d09869"^^xsd:anyURI ;
    rbo:reviewsAlbum res:Album_b93a7c47-a6d4-33f2-9034-53fdd991f4ba ;
