    rbo:mbid "ffc067e4-792b-4978-9b7d-6601fdb44323" ;
    rbo:publishedOn "2024-07-02T15:59:32+00:00"^^xsd:dateTime ;
    rbo:rating 4 ;
    rbo:reviewText "Slyšel jsem větsinu MSI diskografie, nicméně toto album mi přišlo jako skutečný *[industrial jungle pussy punk](https://www.last.fm/tag/industrial+jungle+pussy+punk/wiki)*, za který se MSI vydává. Mix elektronických, punkových a industrial prvků společně skvěle zapadá, lepší už jsou jen texty, které mají smysl a význam. Některé texty jsou však trochu drsné (např. *Mastermind*; ale nejspíš to dává smysl s ohledem na dobu, kdy bylo album vydané), nicméně nenechte se tím odradit a poslechněte si alespoň pár skladeb."@cs ;
    rbo:reviewUrl "https://critiquebrainz.org/review/ffc067e4-792b-4978-9b7d-6601fdb44323"^^xsd:anyURI ;
    rbo:reviewsAlbum res:Album_08d679ce-496f-3e75-a8ff-5aade0f0b0a6 ;
    rbo:writtenBy res:User_b373b635-789d-4a7b-aced-71556d86a5ac .

