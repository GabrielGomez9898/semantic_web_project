    rbo:publishedOn "2022-01-07T14:41:26+00:00"^^xsd:dateTime ;
    rbo:rating 3 ;
    rbo:reviewText "A perfectly servicable pop record, but not much else. Corinne certainly can sing. The production is really good. The singles are memorable and singable. But it doesn't do much else in my opinion, maybe it'll grow on me."@en ;
    rbo:reviewUrl "https://critiquebrainz.org/review/c028d409-8416-4912-b958-0a03b8f914dc"^^xsd:anyURI ;
