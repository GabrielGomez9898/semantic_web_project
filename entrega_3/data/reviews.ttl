    rbo:publishedOn "2023-10-15T22:00:38+00:00"^^xsd:dateTime ;
    rbo:rating 5 ;
    rbo:reviewText "I really like this group, I found them randomly on youtube years ago and it was love at first sight. Their songs are inspiring and epic, the lyrics are beautiful and meaningful, and the music is just perfect for my taste."@en ;
    rbo:reviewUrl "https://critiquebrainz.org/review/e0a7d400-f4c9-4989-b6a5-3a3a3866c3b5"^^xsd:anyURI ;
