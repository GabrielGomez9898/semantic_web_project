res:Review_eff2bba1-0024-4cbb-8130-7e999761cb95 a res:Review ;
    rbo:language "en" ;
    rbo:license "CC BY-NC-SA 3.0" ;
    rbo:matchMethod "artista_mbid" ;
    rbo:mbid "eff2bba1-0024-4cbb-8130-7e999761cb95" ;
    rbo:publishedOn "2026-02-22T15:55:02+00:00"^^xsd:dateTime ;
    rbo:rating 4 ;
    rbo:reviewText "A friend on the Fedi recommended this. I've found it very enjoyable as background music with personality. They also have covers of songs that I like better than the originals to the point where it's reintroducing me to songs I didn't think I particularly liked. They're definitely a surf rock vibe. I can groove and boogie to this."@en ;
    rbo:reviewUrl "https://critiquebrainz.org/review/eff2bba1-0024-4cbb-8130-7e999761cb95"^^xsd:anyURI ;
