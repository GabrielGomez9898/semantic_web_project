    rbo:reviewText "A pretty solid ska punk album, if a little too long for my liking (nearly 1 hour). A good start for a band that is still going strong today"@en ;
    rbo:reviewUrl "https://critiquebrainz.org/review/debc96b9-364f-48d9-9632-7517e946066e"^^xsd:anyURI ;
