    rbo:mbid "a6eee172-e604-43c3-b817-85ac05111a9f" ;
    rbo:publishedOn "2024-12-31T05:41:17+00:00"^^xsd:dateTime ;
    rbo:rating 2 ;
    rbo:reviewText "Released between their career defining *Tarkus* and *Trilogy*, their first live album is an adaptation of a classical suite. However, they have imbibed their own take on it and it is far away from what the classical adaptations of this piece sound like. Despite this, none of the tracks are a particular standout and this album gets lost in the brilliance that was their initial run."@en ;
    rbo:reviewUrl "https://critiquebrainz.org/review/a6eee172-e604-43c3-b817-85ac05111a9f"^^xsd:anyURI ;
    rbo:reviewsAlbum res:Album_b1fff2ac-34eb-358b-9bf5-196b2a5fc288 ;
    rbo:writtenBy res:User_6f3bbf71-cd35-4aa4-8e82-de3350738c59 .

