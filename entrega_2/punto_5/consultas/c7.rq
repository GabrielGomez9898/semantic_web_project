PREFIX res: <http://uniandes.edu.co/wsproject2026/vocab/lit#> 
PREFIX rbo: <http://uniandes.edu.co/wsproject2026/vocab/ontology#> 
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> 
PREFIX res: <http://uniandes.edu.co/wsproject2026/vocab/lit#> 
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> 



SELECT ?country
WHERE {

    ?artist a res:Artist ;
            rbo:origin ?country .

    ?track a res:Track ;
            rbo:hasTag res:Tag_rock ;
            rbo:sungBy ?artist;

}